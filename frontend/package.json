{
    "name": "meetily",
    "version": "0.4.0",
    "private": true,
    "main": "electron/main.js",
    "scripts": {
        "dev": "next dev --webpack -p 3118",
        "build": "next build --webpack",
        "export": "npm run build",
        "start": "next start -p 3118",
        "tauri": "tauri",
        "tauri:dev": "node scripts/tauri-auto.js dev",
        "tauri:dev:afterword": "node scripts/tauri-auto.js dev --config src-tauri/tauri.afterword.tester.conf.json",
        "tauri:dev:afterword:attach": "node scripts/tauri-auto.js dev --config src-tauri/tauri.afterword.tester.conf.json --config src-tauri/tauri.external-frontend.conf.json",
        "tauri:build": "node scripts/tauri-auto.js build",
        "tauri:build:afterword": "node scripts/tauri-auto.js build --config src-tauri/tauri.afterword.tester.conf.json",
        "tauri:dev:meetnola": "pnpm run tauri:dev:afterword",
        "tauri:dev:meetnola:attach": "pnpm run tauri:dev:afterword:attach",
        "tauri:build:meetnola": "pnpm run tauri:build:afterword",
        "tauri:dev:cpu": "tauri dev",
        "tauri:dev:cuda": "tauri dev -- --features cuda",
        "tauri:dev:vulkan": "tauri dev -- --features vulkan",
        "tauri:dev:metal": "tauri dev -- --features metal",
        "tauri:dev:coreml": "tauri dev -- --features coreml",
        "tauri:dev:openblas": "tauri dev -- --features openblas",
        "tauri:dev:hipblas": "tauri dev -- --features hipblas",
        "tauri:build:cpu": "tauri build",
        "tauri:build:cuda": "tauri build -- --features cuda",
        "tauri:build:vulkan": "tauri build -- --features vulkan",
        "tauri:build:metal": "tauri build -- --features metal",
        "tauri:build:coreml": "tauri build -- --features coreml",
        "tauri:build:openblas": "tauri build -- --features openblas",
        "tauri:build:hipblas": "tauri build -- --features hipblas",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit --incremental false",
        "test:recording": "node --test tests/lib/recording-lifecycle.test.mjs",
        "test:markdown": "node --require ./scripts/register-typescript-tests.cjs --test tests/lib/blocknote-markdown.test.ts"
    },
    "dependencies": {
        "@blocknote/core": "0.36.0",
        "@blocknote/react": "0.36.0",
        "@blocknote/shadcn": "0.36.0",
        "@heroicons/react": "^2.2.0",
        "@hookform/resolvers": "^5.1.1",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-scroll-area": "^1.2.9",
        "@radix-ui/react-select": "^2.2.5",
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-switch": "^1.2.5",
        "@radix-ui/react-tabs": "^1.1.12",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tanstack/react-virtual": "^3.13.13",
        "@tauri-apps/api": "^2.6.0",
        "@tauri-apps/plugin-fs": "^2.4.0",
        "@tauri-apps/plugin-notification": "~2.3.1",
        "@tauri-apps/plugin-os": "^2.3.2",
        "@tauri-apps/plugin-process": "^2.3.0",
        "@tauri-apps/plugin-store": "^2.4.0",
        "@tauri-apps/plugin-updater": "^2.3.0",
        "@tiptap/pm": "^2.10.4",
        "@tiptap/react": "^2.10.4",
        "@tiptap/starter-kit": "^2.10.4",
        "@types/lodash": "^4.17.13",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.1.0",
        "framer-motion": "^11.15.0",
        "lodash": "^4.17.21",
        "lucide-react": "^0.469.0",
        "next": "16.3.4",
        "radix-ui": "^1.4.3",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-hook-form": "^7.59.0",
        "react-markdown": "^9.0.1",
        "remark-gfm": "^4.0.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.3.1",
        "tailwindcss-animate": "^1.0.7",
        "zod": "^3.25.71"
    },
    "pnpm": {
        "overrides": {
            "prosemirror-model": "1.25.3",
            "prosemirror-state": "1.4.3",
            "prosemirror-view": "1.41.3",
            "prosemirror-transform": "1.10.4",
            "prosemirror-tables": "1.8.1"
        }
    },
    "devDependencies": {
        "@tailwindcss/typography": "^0.5.15",
        "@tauri-apps/cli": "^2.1.0",
        "@tauri-apps/plugin-fs": "~2.4.0",
        "@types/node": "^20",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.7",
        "autoprefixer": "^10.0.1",
        "concurrently": "^8.2.2",
        "postcss": "^8",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.7.2",
        "wait-on": "^7.2.0",
        "eslint": "^9.0.0",
        "eslint-config-next": "16.3.4"
    },
    "engines": {
        "node": ">=20.9.0"
    },
    "packageManager": "pnpm@9.15.9"
}
